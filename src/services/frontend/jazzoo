#
# React
#

install():
    yarn install

[interactive]
run-server():
    yarn dev -H 0.0.0.0 -p 3001

#
# Stack
#

init-dev(): install()

# Succeeds when the server responds (the healthcheck of docker-compose.init-stack.yml).
check():
    wget -q -O /dev/null http://127.0.0.1:3001/

create-opt-paths():
    sudo mkdir -p /opt/projects/gatsblog/frontend
    sudo echo     "- cmd: echo 'start of the fish history'" >> /opt/projects/gatsblog/frontend/fish_history
    sudo chmod -R 777 /opt/projects/gatsblog
